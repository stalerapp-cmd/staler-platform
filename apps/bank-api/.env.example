# TalerBank API — copy to .env for local runs (never commit real values).
NODE_ENV=development
PORT=4000
# Supabase: use the *pooler* URL (Session mode, port 5432). Render has no IPv6, so the direct db.<ref>.supabase.co host will not work there.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SCHEMA=talerbank
DB_SSL=require                      # disable only for a local database
RUN_MIGRATIONS=true

PUBLIC_URL=http://localhost:4000    # https://… in production (used in QR codes and e-mails)
CORS_ORIGINS=                       # extra browser origins, comma-separated (the Android app is always allowed)
# WEB_DIST_DIR=../bank-web/dist     # default; the API serves the built web app

# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# exactly 32 bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=          # during key rotation only

# Shared with S-Taler (must be identical in both services)
EXCHANGE_API_TOKEN=
WEBHOOK_SECRET=
STALER_WEBHOOK_URL=http://localhost:5000/api/bank/webhook

BANK_NAME=TalerBank
CURRENCY=PS
MAX_TRANSFER=10000
DAILY_TRANSFER_LIMIT=50000
SIGNUP_BONUS=0

# First administrator (created or re-secured on start)
BANK_ADMIN_EMAIL=
BANK_ADMIN_PASSWORD=

# E-mail: smtp in production; "log" prints codes to the server log (development only)
MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TalerBank <no-reply@example.com>"
LOG_LEVEL=info
