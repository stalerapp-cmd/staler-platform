{
  "name": "staler-api",
  "version": "3.0.0",
  "private": true,
  "description": "S-Taler wallet API — wallets, transfers, QR payments, marketplace, messaging, exchange vouchers and TalerBank integration",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@supabase/supabase-js": "2.75.1",
    "bcryptjs": "2.4.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "express": "4.22.1",
    "express-rate-limit": "7.5.1",
    "file-type": "22.2.0",
    "helmet": "8.1.0",
    "jose": "5.10.0",
    "multer": "2.5.0",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "2.1.9"
  },
  "overrides": {
    "qs": "6.17.0"
  }
}
