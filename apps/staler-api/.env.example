# S-Taler API — copy to .env for local runs (never commit real values).
NODE_ENV=development
PORT=5000
# Same Supabase database as TalerBank (pooler URL, Session mode, port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SCHEMA=public
DB_SSL=require
RUN_MIGRATIONS=true

PUBLIC_URL=http://localhost:5000
CORS_ORIGINS=
# WEB_DIST_DIR=../staler-web/dist

JWT_SECRET=
ENCRYPTION_KEY=
# The ENCRYPTION_KEY of the OLD S-Taler server, so data it encrypted can still be read and is re-encrypted on start.
LEGACY_ENCRYPTION_KEY=

# TalerBank
BANK_API_URL=http://localhost:4000      # https://… in production
# BANK_PUBLIC_URL=                      # link shown to users, defaults to BANK_API_URL
EXCHANGE_API_TOKEN=                     # identical to TalerBank's
WEBHOOK_SECRET=                         # identical to TalerBank's

SITE_NAME=S-Taler
CURRENCY=PS
MAX_TRANSFER=10000
DAILY_TRANSFER_LIMIT=50000

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Supabase Storage for product images / digital files (otherwise stored in the database)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="S-Taler <no-reply@example.com>"
LOG_LEVEL=info
